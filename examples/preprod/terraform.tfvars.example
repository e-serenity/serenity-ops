# Copy this file to terraform.auto.tfvars (gitignored) and replace with your own values.
dashboard_allowed_ips = [
  "10.0.0.1/32",
  "2001:db8:1234:5678::/64",
]

# (Optional) Initial secrets for the bot.
# These values are only used upon initial AWS Secrets Manager secret creation.
# In production, it is recommended to leave this empty and populate tokens directly
# in the AWS Secrets Manager console to avoid storing plain credentials in local files or git.
# bot_initial_secrets = {
#   SLACK_BOT_TOKEN = "xoxb-..."
#   SLACK_APP_TOKEN = "xapp-..."
#   GEMINI_APIKEY   = "..."
#   GITLAB_TOKEN    = "glpat-..."
#   GITHUB_TOKEN    = "ghp_..."
#   DD_API_KEY      = "..."
#   DD_APP_KEY      = "..."
# }

